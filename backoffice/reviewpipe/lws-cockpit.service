# lws-cockpit — the Station (backoffice/reviewpipe/serve.ts) as a permanent service on the box, without Docker or Coolify.
# A systemd USER service, NOT installed by default (architecture/scheduling/install-units.sh, or cron.md).
#
# It listens on 127.0.0.1:${BACKOFFICE_PORT:-4000} (BACKOFFICE_HOST, default loopback). To open it to the
# world: an HTTPS reverse proxy in front (Caddy, see docs/GUIDE.md), AND BACKOFFICE_PASSWORD in ~/lws/.env (Basic
# auth on everything, except /t/, the emails' public tracking). Without a password, an external Host gets 403: the
# Station is never exposed bare by accident. To keep it private: an SSH tunnel is enough
#   ssh -N -L 4000:127.0.0.1:4000 <you>@<box>   then http://127.0.0.1:4000 on your computer
#
# The cockpit also serves the signed tracking (/t/c/…, /t/u/…: TRACK_BASE + LWS_TRACK_SECRET, outreach/tracking/).

[Unit]
Description=lastwebstudios — Station (cockpit, CRM /outreach, call cockpit, Machine view, tracking /t/)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/lws
EnvironmentFile=-%h/lws/.env
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env npm run backoffice:serve
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
