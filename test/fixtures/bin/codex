#!/usr/bin/env node
/**
 * FAUX `codex` (Codex CLI d'OpenAI) pour les tests : en tête du PATH via test/run.mjs (même dossier que le faux
 * `claude`), pour qu'AUCUN test ne parle au vrai modèle ni à l'abonnement ChatGPT. Imite ce que le produit lit :
 *
 *   --version                       version
 *   login status                    « Logged in using ChatGPT » (FAKE_CODEX_AUTH=none : non connecté, code 1 ;
 *                                   FAKE_CODEX_AUTH=api : « Logged in using API key »)
 *   exec [opts] -                   prompt sur stdin ; -o <fichier> reçoit le dernier message ; --output-schema <f>
 *                                   contraint le JSON ; -i <image> (répétable) ; -m <modèle> ; --json : évènements
 *
 * La réponse vient du FAUX `claude` du même dossier (il reconnaît les prompts du produit : structuration, porte
 * visuelle…) : on lui passe le même prompt, on prend `structured_output` (ou `result`). Ainsi la voie codex rend
 * exactement les mêmes données fictives que la voie claude-code.
 *
 * Réglages : FAKE_CODEX_LOG=<fichier> (JSONL : argv, prompt, clé API présente ?) · FAKE_CODEX_RESULT=<json> (réponse
 * forcée) · FAKE_CODEX_MODE=fail (code 1, « not logged in »)
 */
import { appendFileSync, readFileSync, writeFileSync } from "node:fs"
import { spawnSync } from "node:child_process"
import { join, dirname } from "node:path"
import { fileURLToPath } from "node:url"

const argv = process.argv.slice(2)
const opt = (f) => { const i = argv.indexOf(f); return i >= 0 ? argv[i + 1] : undefined }
const all = (f) => argv.map((a, i) => (a === f ? argv[i + 1] : null)).filter(Boolean)

if (argv.includes("--version")) { process.stdout.write("codex-cli 0.0.0-fake\n"); process.exit(0) }
if (argv[0] === "login" && argv[1] === "status") {
  const a = process.env.FAKE_CODEX_AUTH || "chatgpt"
  if (a === "none") { process.stderr.write("Not logged in\n"); process.exit(1) }
  process.stdout.write(a === "api" ? "Logged in using API key\n" : "Logged in using ChatGPT\n"); process.exit(0)
}
if (argv[0] !== "exec") { process.stderr.write(`faux codex : commande inconnue ${argv[0]}\n`); process.exit(2) }

const prompt = readFileSync(0, "utf8")
const schemaArg = opt("--output-schema")
let schema = null
if (schemaArg) { try { schema = JSON.parse(readFileSync(schemaArg, "utf8")) } catch { schema = "illisible" } } // lu ICI : le produit efface son dossier temporaire après l'appel
if (process.env.FAKE_CODEX_LOG) appendFileSync(process.env.FAKE_CODEX_LOG, JSON.stringify({ argv, prompt, hasApiKey: Boolean(process.env.OPENAI_API_KEY), images: all("-i"), model: opt("-m") ?? null, schema }) + "\n")
if (process.env.FAKE_CODEX_MODE === "fail") { process.stderr.write("error: not logged in. Run `codex login`.\n"); process.exit(1) }

let text = process.env.FAKE_CODEX_RESULT
if (!text) {
  const schemaFile = opt("--output-schema")
  const claude = join(dirname(fileURLToPath(import.meta.url)), "claude")
  const args = ["-p", "--output-format", "json", "--model", opt("-m") || "fake"]
  if (schemaFile) args.push("--json-schema", readFileSync(schemaFile, "utf8"))
  const r = spawnSync(process.execPath, [claude, ...args], { input: prompt, encoding: "utf8", env: { ...process.env, FAKE_CLAUDE_LOG: "" } })
  let env
  try { env = JSON.parse(r.stdout) } catch { process.stderr.write(`faux codex : le faux claude n'a pas répondu en JSON\n${r.stderr}`); process.exit(1) }
  text = env.structured_output !== undefined ? JSON.stringify(env.structured_output) : String(env.result ?? "")
}

const out = opt("-o")
if (out) writeFileSync(out, text + "\n")
if (argv.includes("--json")) {
  process.stdout.write(JSON.stringify({ type: "thread.started", thread_id: "fake-thread", model: opt("-m") || "fake-codex" }) + "\n")
  process.stdout.write(JSON.stringify({ type: "item.completed", item: { type: "agent_message", text } }) + "\n")
  process.stdout.write(JSON.stringify({ type: "turn.completed", usage: { input_tokens: 12, output_tokens: 34 } }) + "\n")
} else process.stdout.write(text + "\n")
