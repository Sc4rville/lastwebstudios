#!/usr/bin/env node
/**
 * FAKE `claude` (Claude Code CLI) for the tests: put first on the PATH and in CLAUDE_BIN by test/run.mjs,
 * so that NO test talks to the real model (neither plan nor API). Imitates what the product reads:
 *
 *   --version · auth status                          version, sign-in state (JSON)
 *   -p --output-format json [--json-schema S]        envelope { type:"result", subtype:"success", result, structured_output }
 *   -p --output-format stream-json [--json-schema S] a system/init event (tools), a few events, a `result`
 *
 * It recognises the product's prompts (structuration, composer agents, first-site launcher) and answers with
 * 100 % fictional data; the "compose" agents write a real little site (clean for lint and verify).
 *
 * Settings through variables:
 *   FAKE_CLAUDE_LOG=<file>        logs each call (argv + prompt received on stdin) as JSONL
 *   FAKE_CLAUDE_RESULT=<json>     forced answer on the json path (otherwise: the answer for the recognised prompt)
 *   FAKE_CLAUDE_MODE=limit        simulates the plan's session limit · =fail: exit code 1
 *   FAKE_CLAUDE_MKDIR=<folder>    (stream-json, the worker's composer agent) creates this folder WITHOUT an index.html
 *   FAKE_CLAUDE_NO_STRUCTURED=1   never emits `structured_output` (tests the regex fallback)
 *   FAKE_CLAUDE_AUTH=none         `auth status`: signed out
 *   FAKE_CLAUDE_NO_WORKFLOW=1     the Workflow tool is missing from init
 *   FAKE_CLAUDE_JUDGE=tie         the blind judge cannot decide (the beauty-gate fails)
 *   FAKE_CLAUDE_COST=<usd>        the result's `total_cost_usd` (default 0): tests the worker's spend ledger
 *   FAKE_CLAUDE_SLEEP_MS=<ms>     (stream-json) the agent "works" this long before answering (tests STOP mid-job)
 *   FAKE_CLAUDE_CHUNKED=<n>       writes stdout in chunks of n bytes (1 ms apart): a UTF-8 character or a
 *                                 JSON line split between two reads, as on a real pipe when the output is long
 */
import { appendFileSync, readFileSync, mkdirSync, writeFileSync } from "node:fs"
import { join, dirname } from "node:path"

const argv = process.argv.slice(2)
const has = (f) => argv.includes(f)
const opt = (f) => (has(f) ? argv[argv.indexOf(f) + 1] : undefined)
const fmt = opt("--output-format") || "text"

// output: in one block (default), or in small byte chunks (FAKE_CLAUDE_CHUNKED) to test the product's readers
const CHUNK = Number(process.env.FAKE_CLAUDE_CHUNKED) || 0
let pending = Promise.resolve()
function emit(str) {
  if (!CHUNK) { process.stdout.write(str); return }
  const buf = Buffer.from(str, "utf8")
  pending = pending.then(async () => {
    for (let i = 0; i < buf.length; i += CHUNK) {
      process.stdout.write(buf.subarray(i, i + CHUNK))
      await new Promise((r) => setTimeout(r, 1))
    }
  })
}
const exit = async (code) => { await pending; process.exit(code) }

if (has("--version")) { console.log("9.9.9 (Claude Code, fake test binary)"); process.exit(0) }
if (argv[0] === "auth" && argv[1] === "status") {
  const out = process.env.FAKE_CLAUDE_AUTH === "none"
    ? { loggedIn: false, authMethod: "none", apiProvider: "firstParty" }
    : { loggedIn: true, authMethod: "claude.ai", apiProvider: "firstParty", subscriptionType: "max", email: "test@lws.example" }
  console.log(JSON.stringify(out, null, 2))
  process.exit(0)
}

let stdin = ""
try { stdin = readFileSync(0, "utf8") } catch { /* no stdin */ }
if (process.env.FAKE_CLAUDE_LOG) {
  // presence (never the value) of the variables that decide billing: the product must remove the API key
  const env = { ANTHROPIC_API_KEY: !!process.env.ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN: !!process.env.ANTHROPIC_AUTH_TOKEN, CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS: process.env.CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS ?? null }
  appendFileSync(process.env.FAKE_CLAUDE_LOG, JSON.stringify({ at: new Date().toISOString(), argv, cwd: process.cwd(), env, stdin }) + "\n")
}
const mode = process.env.FAKE_CLAUDE_MODE || ""
if (mode === "fail") { console.error("fake claude: simulated failure"); process.exit(1) }

/** A small composed site, fictional and CLEAN (0 em dash, no disk asset, no @font-face, viewport). */
function writeSite(indexPath, id, prefs = []) {
  mkdirSync(dirname(indexPath), { recursive: true })
  writeFileSync(indexPath, `<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Orvane Piscines, Valmont-sur-Lys</title><style>body{margin:0;font-family:system-ui,sans-serif;color:#0b2530;background:#f4f8f9}
header,section,footer{padding:48px 6vw;max-width:1100px;margin:0 auto}h1{font-size:clamp(2rem,6vw,4.5rem);line-height:1.05;margin:0 0 16px}
a.cta{display:inline-block;padding:14px 22px;background:#0b6e8a;color:#fff;border-radius:6px;text-decoration:none}a.cta:hover{background:#09566c}</style></head>
<body><header><h1>Votre piscine, notre savoir-faire depuis 1998</h1><p>Construction et rénovation de piscines familiales dans la vallée de la Lys.</p>
<a class="cta" href="tel:+33353012468">Appeler l'atelier</a></header><section><h2>Ce que nous faisons</h2><ul><li>Construction de piscines</li>
<li>Rénovation de bassins</li><li>Spas et abris</li><li>Entretien saisonnier</li></ul></section>
<footer><p>Orvane Piscines (prospect fictif de test, ${id})</p></footer></body></html>\n`)
  writeFileSync(join(dirname(indexPath), "control.md"), `# ${id}\n\ntemplate: composer\nverdict: (fake claude)\n${prefs.length ? `- preferences : ${prefs.join(", ")}\n` : ""}`)
}

// canonical answers per recognised prompt, 100 % fictional data
function answerFor(prompt) {
  if (process.env.FAKE_CLAUDE_RESULT) return process.env.FAKE_CLAUDE_RESULT
  if (/## TEXTE BRUT/.test(prompt)) {
    return JSON.stringify({
      identity: { phone: "03 53 01 24 68", email: "contact@orvane-piscines.example", hours: "Lun-Sam 9h-18h", zone: "Vallée de la Lys" },
      content: {
        tagline: "Votre piscine, notre savoir-faire depuis 1998",
        about: "Orvane Piscines construit et rénove des piscines familiales dans la vallée de la Lys. Une petite équipe, des chantiers suivis de A à Z.",
        services: ["construction de piscines", "rénovation de bassins", "spas et abris", "entretien saisonnier"],
        brands: ["Aquaclair"],
      },
    })
  }
  if (/SCREENSHOTS TO ANALYSE|CAPTURES À ANALYSER/.test(prompt) && /besoin/.test(prompt)) return JSON.stringify({ besoin: 82, reasons: ["design daté des années 2010 (faux juge)", "typographie système"] })
  // composer agents (compose-batch.workflow.js), local engine
  if (/DÉMARRE LE CHRONO DE GEN|START THE GENERATION CLOCK/.test(prompt)) return JSON.stringify({ beauty_before: { score: 3, why: "site daté (faux)" }, what: "pisciniste", problems: ["tableaux de mise en page", "pas de viewport"], angle: "l'eau qui vend", moves: ["héros photo plein-bleed"] })
  if (/Maillon ASSET-BOOST|ASSET-BOOST step for/.test(prompt)) return JSON.stringify({ boosted: [], heroVideo: false, notes: "audit only (fake claude)" })
  const compose = /(?:Compose le site SUR-MESURE de|Compose the CUSTOM site of) "([^"]+)"/.exec(prompt)
  if (compose) {
    const out = /(?:SORTIE :|OUTPUT:) (output\/sites\/[^\s]+\/index\.html)/.exec(prompt)
    // the owner's preferences it was given (D6) : the fake composer « applies » them all and says so, like a real one
    const block = /<owner_preferences>\n([\s\S]*?)\n<\/owner_preferences>/.exec(prompt)
    const prefs = block ? [...block[1].matchAll(/^- \[(p-[a-z0-9-]+)\]/gm)].map((m) => m[1]) : []
    if (out) writeSite(out[1], compose[1], prefs)
    return JSON.stringify({ ok: !!out, path: out ? out[1] : "", fontPair: "Host Grotesk × Geist", lintClean: true, verifyClean: true, preferences: prefs, notes: "fictional site written by the fake claude" })
  }
  // the learn-taste skill (role fast) : one general preference from the feedback's words, fictional
  if (/^# Learn taste/m.test(prompt)) {
    const text = (/"text": "([^"]*)"/.exec(prompt) || [])[1] || ""
    if (/typo|hours/i.test(text)) return JSON.stringify({ preferences: [] })
    return JSON.stringify({ preferences: [{ text: "Show the team's faces in the about section", same_as: "", replaces: "", quote: text.slice(0, 200), area: "proof", general: true }] })
  }
  if (/Tu viens de composer|You have just composed/.test(prompt)) return JSON.stringify({ improved: false, rounds: 0, fixes: [], notes: "nothing to fix (fake)" })
  if (/Juge de design NEUTRE|NEUTRAL and SEVERE design judge/.test(prompt)) {
    const newIsA = /Image A : output\/sites\//.test(prompt)
    if (process.env.FAKE_CLAUDE_JUDGE === "tie") return JSON.stringify({ more_beautiful: "tie", margin: "tie", reasons: ["undecided (fake judge)"] })
    return JSON.stringify({ more_beautiful: newIsA ? "A" : "B", margin: "much", reasons: ["clear hierarchy (fake judge)", "a photo that carries the hero"] })
  }
  // first-site's "workflow" engine launcher: simulates the Workflow (site written + result)
  if (/FIRST_SITE_RESULT=/.test(prompt)) {
    const m = /args: (\{.*\}) \}\)/.exec(prompt)
    let args = {}
    try { args = JSON.parse(m[1]) } catch { /* */ }
    const id = (args.ids || [])[0] || "inconnu"
    writeSite(`output/sites/${id}/${args.date}-composer/index.html`, id)
    return "FIRST_SITE_RESULT=" + JSON.stringify({ engines: { boost: args.boost, image: args.image, video: args.video, sync: args.sync, models: args.models }, passed: [{ id, font: "Host Grotesk", loops: 1, verdict: { more_beautiful: "A", margin: "much", reasons: ["faux workflow"] } }], failed: [] })
  }
  return "{}"
}

function structuredOf(text) {
  if (!has("--json-schema") || process.env.FAKE_CLAUDE_NO_STRUCTURED === "1") return undefined
  try { const v = JSON.parse(text); return v && typeof v === "object" ? v : undefined } catch { return undefined }
}

const TOOLS = ["Agent", "Bash", "Edit", "Read", "Skill", "WebFetch", "WebSearch", "Workflow", "Write"].filter((t) => !(t === "Workflow" && process.env.FAKE_CLAUDE_NO_WORKFLOW === "1"))

if (fmt === "stream-json") {
  const out = (o) => emit(JSON.stringify(o) + "\n")
  out({ type: "system", subtype: "init", model: "fake", tools: TOOLS, apiKeySource: "none" })
  if (mode === "limit") {
    out({ type: "assistant", message: { content: [{ type: "text", text: "Claude usage limit reached. Your limit resets 3am (UTC)" }] } })
    out({ type: "result", subtype: "error", is_error: true, result: "Claude usage limit reached. resets 3am (UTC)", usage: { input_tokens: 1, output_tokens: 1 }, total_cost_usd: 0 })
    await exit(1)
  }
  if (process.env.FAKE_CLAUDE_MKDIR && /^# compose-worker/m.test(stdin)) { // only the composer agent
    const dir = process.env.FAKE_CLAUDE_MKDIR
    mkdirSync(dir, { recursive: true })
    writeFileSync(join(dir, "brouillon.html"), "<p>interrupted build (fake claude)</p>")
  }
  const text = answerFor(stdin)
  out({ type: "assistant", message: { content: [{ type: "text", text: "fake agent: simulated work" }, { type: "tool_use", name: "Read", input: { file_path: "README.md" } }] } })
  const sleepMs = Number(process.env.FAKE_CLAUDE_SLEEP_MS) || 0
  if (sleepMs) await new Promise((r) => setTimeout(r, sleepMs))
  const structured = structuredOf(text)
  out({ type: "result", subtype: "success", is_error: false, result: text === "{}" ? "fake agent: done" : text, ...(structured ? { structured_output: structured } : {}), usage: { input_tokens: 120, output_tokens: 40, cache_read_input_tokens: 0, cache_creation_input_tokens: 0 }, total_cost_usd: Number(process.env.FAKE_CLAUDE_COST) || 0 })
  await exit(0)
}

if (fmt === "json") {
  const text = answerFor(stdin)
  const structured = structuredOf(text)
  emit(JSON.stringify({ type: "result", subtype: "success", is_error: false, result: text, ...(structured ? { structured_output: structured } : {}), usage: { input_tokens: 50, output_tokens: 30 }, modelUsage: { [opt("--model") || "fake"]: {} }, total_cost_usd: Number(process.env.FAKE_CLAUDE_COST) || 0 }))
  await exit(0)
}

process.stdout.write("fake claude: ok\n")
