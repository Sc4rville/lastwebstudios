# ─── LLM provider (any OpenAI-compatible /chat/completions endpoint) ───────────
# Leave LLM_API_KEY empty to run offline: skills are then answered from demo/replay/.
LLM_BASE_URL=
LLM_API_KEY=
# Default model, and optional per-task-class overrides (mechanical < extract < design < strategy)
LLM_MODEL=
LLM_MODEL_MECHANICAL=
LLM_MODEL_EXTRACT=
LLM_MODEL_DESIGN=
LLM_MODEL_STRATEGY=
# Your provider's price in USD per 1M tokens — feeds the spend meter and the budget cage
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=

# ─── The cage: hard budget ceilings in USD (empty = no ceiling) ────────────────
CYCLE_BUDGET_USD=
DAILY_BUDGET_USD=
LIFETIME_BUDGET_USD=

# ─── Pipeline switches ─────────────────────────────────────────────────────────
# FORCE=1 skips the scoring gate · DESIGN=0 stops after the prospect sheet · LIMIT=n
FORCE=
DESIGN=
LIMIT=
