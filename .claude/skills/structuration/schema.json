{
  "type": "object",
  "description": "Output of the structuration skill (prompt.md): contact identity and content sorted from the raw text. Fields absent from the text: omitted.",
  "properties": {
    "identity": {
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "hours": { "type": "string" },
        "zone": { "type": "string" }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "tagline": { "type": "string" },
        "about": { "type": "string" },
        "services": { "type": "array", "items": { "type": "string" } },
        "brands": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["services"],
      "additionalProperties": false
    }
  },
  "required": ["content"],
  "additionalProperties": false
}
